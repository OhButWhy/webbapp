# Пример переменных окружения для backend (FastAPI).
# Скопируйте в backend/.env (или задайте в настройках хостинга, напр. Render).

# --- OpenRouter (ИИ-стилист) ---
# Ключ с https://openrouter.ai/ . Без валидного ключа провайдер вернёт 401,
# и чат покажет заглушку "ИИ-стилист временно недоступен из-за ошибки авторизации".
OPENROUTER_API_KEY=your_openrouter_api_key_here
# (опционально) модели
# OPENROUTER_MODEL=qwen/qwen-vl-plus
# OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# --- Поиск по маркетплейсам ---
# Реальный поиск (Wildberries + playwright) включён по умолчанию.
# Поставьте 0, чтобы принудительно использовать заглушку из 10 ссылок.
REAL_MARKETPLACE_ENABLED=1
# (опционально) прокси для запросов к маркетплейсу, если прямой доступ заблокирован
# WB_PROXY=http://user:pass@host:port
# MARKETPLACE_PROXY=http://user:pass@host:port
